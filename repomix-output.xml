@import 'tailwindcss';

/*
  KAHF Treasure — Design System
  Source of truth: docs/BRAND_GUIDELINES.md
  Light, luxury aesthetic: white surfaces, ink text, gold accent, generous whitespace.
*/

@theme {
  /* ---- Brand colours (BRAND_GUIDELINES.md » Color Palette) ---- */
  --color-ink: #0b0b0b; /* Primary — near-black */
  --color-ink-soft: #1e1e1e; /* Text primary */
  --color-gold: #c8a96a; /* Secondary — champagne gold */
  --color-gold-deep: #a8894b; /* Gold, pressed/darker states */
  --color-gold-soft: #e7d8bb; /* Gold tint for borders/backgrounds */
  --color-canvas: #ffffff; /* Background */
  --color-surface: #f7f7f7; /* Raised surface */
  --color-surface-2: #f1efea; /* Warm surface (sand) */
  --color-muted: #666666; /* Text secondary */
  --color-line: #e5e5e5; /* Border */
  --color-emerald: #0f766e; /* Optional accent */

  /* Status */
  --color-success: #16a34a;
  --color-warning: #f59e0b;
  --color-error: #dc2626;

  /* ---- Typography ---- */
  --font-display: var(--font-display); /* Playfair Display */
  --font-serif: var(--font-serif); /* Cormorant Garamond */
  --font-sans: var(--font-sans); /* Inter */
  --font-bengali: var(--font-bengali); /* Noto Serif Bengali */

  /* ---- Radius (BRAND_GUIDELINES.md » Border Radius) ---- */
  --radius-btn: 12px;
  --radius-input: 12px;
  --radius-card: 16px;
  --radius-image: 18px;

  /* ---- Soft shadows only ---- */
  --shadow-card: 0 1px 2px rgba(11, 11, 11, 0.04), 0 8px 24px rgba(11, 11, 11, 0.06);
  --shadow-card-hover: 0 2px 6px rgba(11, 11, 11, 0.06), 0 18px 44px rgba(11, 11, 11, 0.1);
  --shadow-soft: 0 10px 40px rgba(11, 11, 11, 0.08);

  /* ---- Motion (150–300ms per guidelines) ---- */
  --ease-lux: cubic-bezier(0.22, 1, 0.36, 1);

  /* ---- Layout ---- */
  --nav-h: 76px;
}

/* ======== BASE ======== */
:root {
  color-scheme: light;
}

* {
  border-color: var(--color-line);
}

html {
  scroll-behavior: smooth;
  /* Offset in-page anchors so the sticky nav never covers a heading */
  scroll-padding-top: calc(var(--nav-h) + 16px);
  -webkit-text-size-adjust: 100%;
}

body {
  background-color: var(--color-canvas);
  color: var(--color-ink-soft);
  font-family: var(--font-sans), ui-sans-serif, system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

::selection {
  background: var(--color-gold);
  color: #fff;
}

/* Accessible, on-brand focus ring for keyboard users */
:focus-visible {
  outline: 2px solid var(--color-gold-deep);
  outline-offset: 2px;
  border-radius: 4px;
}

/* ======== TYPOGRAPHIC HELPERS ======== */
.font-display {
  font-family: var(--font-display), ui-serif, Georgia, serif;
  letter-spacing: -0.01em;
}
.font-serif {
  font-family: var(--font-serif), ui-serif, Georgia, serif;
}
.font-bengali {
  font-family: var(--font-bengali), var(--font-sans), sans-serif;
}

/* Eyebrow / kicker label used across sections */
.eyebrow {
  font-family: var(--font-sans), sans-serif;
  text-transform: uppercase;
  letter-spacing: 0.28em;
  font-size: 0.7rem;
  font-weight: 500;
  color: var(--color-gold-deep);
}

/* Thin gold rule used as a decorative divider */
.gold-rule {
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    var(--color-gold) 20%,
    var(--color-gold) 80%,
    transparent
  );
}

/* ======== SCROLLBAR ======== */
::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}
::-webkit-scrollbar-track {
  background: var(--color-surface);
}
::-webkit-scrollbar-thumb {
  background: #d9d2c4;
  border: 2px solid var(--color-surface);
  border-radius: 9999px;
}
::-webkit-scrollbar-thumb:hover {
  background: var(--color-gold);
}

/* ======== REVEAL-ON-SCROLL (progressive enhancement) ======== */
/* Elements start hidden ONLY when JS/motion is active; see Reveal component.
   If the user prefers reduced motion, everything is shown immediately. */
@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ======== UTILITIES ======== */
/* Subtle grain-free luxury texture: a barely-there warm vignette for hero areas */
.lux-vignette {
  background:
    radial-gradient(120% 80% at 50% 0%, rgba(200, 169, 106, 0.08), transparent 60%),
    linear-gradient(180deg, var(--color-surface-2), var(--color-canvas));
}

/* Hide scrollbar for horizontal rails while keeping scroll */
.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}
.no-scrollbar::-webkit-scrollbar {
  display: none;
}
