            <span className='text-[0.65rem] font-medium text-[var(--color-gold)]'>({product.reviewCount || 0})</span>
          </div>
        )}

        {/* Price + Action */}
        <div className='mt-3 border-t border-[var(--color-border)] pt-2.5 flex flex-col gap-2'>
          <div>
            <span className='block mb-0.5 text-[0.58rem] font-semibold text-[var(--color-muted)]'>দাম</span>
            <span className='whitespace-nowrap text-sm sm:text-base font-bold text-[var(--color-text-primary)]'>
              ৳{minPrice}
            </span>
            {product.compareAtPrice && product.compareAtPrice > minPrice && (
              <span className='ml-1.5 text-xs text-[var(--color-muted)] line-through'>৳{product.compareAtPrice}</span>
            )}
          </div>

          {inStock ? (
            <button
              type='button'
              onClick={handleAddToCart}
              className='relative z-10 flex w-full items-center justify-center gap-1.5 rounded-full bg-[var(--color-gold)] py-1.5 sm:py-2 text-[0.65rem] sm:text-[0.68rem] font-bold text-[var(--color-background)] shadow-md transition-all hover:brightness-110 active:scale-95'
            >
