          className={cn(
            'transition-colors duration-300',
            scrolled || menuOpen
              ? 'bg-[#090807]/95 backdrop-blur-md border-b border-[#c8a96a]/20 shadow-xl'
              : 'bg-[#090807]/90 backdrop-blur-sm border-b border-[#c8a96a]/15 shadow-md',
          )}
          aria-label='Main'
