            opacity: 1;
            transform: translateY(0);
        }

        /* ============================================
           STICKY NAVIGATION
           ============================================ */
        .nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            height: var(--nav-height);
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(6, 6, 6, 0.6);
            backdrop-filter: blur(24px) saturate(1.4);
            -webkit-backdrop-filter: blur(24px) saturate(1.4);
            border-bottom: 1px solid rgba(201, 168, 76, 0.06);
            transition: all var(--transition-smooth);
        }

        .nav.scrolled {
            background: rgba(6, 6, 6, 0.95);
            border-bottom-color: rgba(201, 168, 76, 0.18);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.4);
        }

        .nav-inner {
            width: 100%;
            max-width: var(--container-max);
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .nav-brand {
            font-family: var(--font-heading);
            font-size: 1.5rem;
            font-weight: 600;
            color: var(--gold-400);
            letter-spacing: 0.2em;
            text-transform: uppercase;
            background: linear-gradient(135deg, var(--gold-300), var(--gold-500));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 6px;
            list-style: none;
        }

        .nav-links a {
            font-family: var(--font-accent);
            font-size: 0.75rem;
            font-weight: 500;
            color: var(--text-secondary);
            padding: 7px 16px;
            border-radius: var(--radius-full);
            transition: all var(--transition-base);
            text-transform: uppercase;
            letter-spacing: 0.12em;
            white-space: nowrap;
            position: relative;
        }
        .nav-links a:hover {
            color: var(--gold-300);
            background: rgba(201, 168, 76, 0.08);
        }

        .nav-cta {
            font-family: var(--font-accent) !important;
            font-size: 0.75rem !important;
            font-weight: 600 !important;
            color: #080604 !important;
            background: var(--gradient-gold) !important;
            padding: 9px 24px !important;
            border-radius: var(--radius-full) !important;
            transition: all var(--transition-base) !important;
            letter-spacing: 0.08em !important;
        }
        .nav-cta:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 24px rgba(201, 168, 76, 0.35) !important;
        }

        /* Mobile menu toggle */
        .nav-toggle {
            display: none;
            background: none;
            border: none;
            cursor: pointer;
            padding: 8px;
        }
        .nav-toggle span {
            display: block;
            width: 24px;
            height: 2px;
            background: var(--gold-400);
            margin: 5px 0;
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 2px;
        }
        .nav-toggle.active span:nth-child(1) {
            transform: rotate(45deg) translate(5px, 5px);
        }
        .nav-toggle.active span:nth-child(2) {
            opacity: 0;
        }
        .nav-toggle.active span:nth-child(3) {
            transform: rotate(-45deg) translate(5px, -5px);
        }

        @media (max-width: 768px) {
            .nav-toggle { display: block; }
            .nav-links {
                position: fixed;
                top: var(--nav-height);
                left: 0;
                right: 0;
                background: rgba(6, 6, 6, 0.98);
                backdrop-filter: blur(30px);
                flex-direction: column;
                padding: 24px 20px;
                gap: 2px;
                transform: translateY(-120%);
                opacity: 0;
                transition: all 0.45s cubic-bezier(0.4, 0, 0.2, 1);
                border-bottom: 1px solid rgba(201, 168, 76, 0.1);
            }
            .nav-links.open {
                transform: translateY(0);
                opacity: 1;
            }
            .nav-links a {
                display: block;
                width: 100%;
                text-align: center;
                padding: 14px 16px;
                font-size: 0.85rem;
                border-radius: var(--radius-md);
            }
        }

        /* ============================================
           HERO SECTION
           ============================================ */
        .hero {
            position: relative;
            padding: calc(var(--nav-height) + 70px) 0 70px;
            text-align: center;
            overflow: hidden;
        }

        .hero-glow {
            position: absolute;
            top: -30%;
            left: 50%;
            transform: translateX(-50%);
            width: 900px;
            height: 600px;
            background: radial-gradient(ellipse, rgba(201, 168, 76, 0.1) 0%, rgba(201, 168, 76, 0.03) 40%, transparent 70%);
            pointer-events: none;
            z-index: 0;
        }

        .hero-content {
            position: relative;
            z-index: 1;
        }

        .hero-logo-wrapper {
            display: inline-block;
            position: relative;
            margin-bottom: 36px;
        }

        .hero-logo-glow {
            position: absolute;
            inset: -30px;
            background: radial-gradient(circle, rgba(201, 168, 76, 0.18) 0%, transparent 70%);
            border-radius: 50%;
            filter: blur(25px);
            transition: all 0.8s ease;
        }
        .hero-logo-wrapper:hover .hero-logo-glow {
            background: radial-gradient(circle, rgba(201, 168, 76, 0.35) 0%, transparent 70%);
        }

        .hero-logo {
            position: relative;
            height: 170px;
            object-fit: contain;
            filter: drop-shadow(0 0 30px rgba(201, 168, 76, 0.4));
            transition: transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .hero-logo-wrapper:hover .hero-logo {
            transform: scale(1.06) rotate(0.5deg);
        }

        .hero h1 {
            font-family: var(--font-bengali);
            font-size: clamp(1.8rem, 5vw, 3.5rem);
            font-weight: 700;
            background: linear-gradient(135deg, var(--gold-200), var(--gold-400), var(--gold-600));
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 14px;
            line-height: 1.3;
            animation: fadeInUp 1s ease forwards;
        }

        .hero-tagline {
            font-family: var(--font-heading);
            font-size: clamp(0.9rem, 2vw, 1.25rem);
            color: rgba(201, 168, 76, 0.6);
            letter-spacing: 0.3em;
            text-transform: uppercase;
            font-weight: 400;
            font-style: italic;
            animation: fadeInUp 1s 0.2s ease both;
        }

        .hero-subtitle {
            font-family: var(--font-bengali);
            font-size: clamp(0.85rem, 2vw, 1rem);
            color: var(--text-secondary);
            max-width: 580px;
            margin: 18px auto 0;
            line-height: 1.9;
            animation: fadeInUp 1s 0.35s ease both;
        }

        .hero-divider {
            width: 100px;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--gold-400), transparent);
            margin: 36px auto 0;
            animation: fadeInUp 1s 0.5s ease both;
            position: relative;
        }
        .hero-divider::after {
            content: '◆';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 0.5rem;
            color: var(--gold-500);
            background: var(--dark-500);
            padding: 0 10px;
        }

        .hero-badges {
            display: flex;
            justify-content: center;
            gap: 16px;
            margin-top: 32px;
            flex-wrap: wrap;
            animation: fadeInUp 1s 0.6s ease both;
        }
        .hero-badge {
            font-family: var(--font-accent);
            font-size: 0.72rem;
            font-weight: 500;
            color: var(--gold-300);
            background: rgba(201, 168, 76, 0.05);
            border: 1px solid rgba(201, 168, 76, 0.12);
            padding: 9px 20px;
            border-radius: var(--radius-full);
            letter-spacing: 0.06em;
            display: flex;
            align-items: center;
            gap: 6px;
            backdrop-filter: blur(8px);
            transition: all var(--transition-base);
        }
        .hero-badge:hover {
            border-color: rgba(201, 168, 76, 0.3);
            background: rgba(201, 168, 76, 0.08);
            transform: translateY(-2px);
        }

        @media (max-width: 480px) {
            .hero { padding: calc(var(--nav-height) + 28px) 0 32px; }
            .hero-logo { height: 100px; }
            .hero-badges { gap: 8px; }
            .hero-badge { font-size: 0.6rem; padding: 5px 10px; }
        }

        @media (max-width: 360px) {
            .hero { padding: calc(var(--nav-height) + 20px) 0 24px; }
            .hero-logo { height: 80px; }
            .hero h1 { font-size: 1.4rem; }
            .hero-tagline { font-size: 0.7rem; letter-spacing: 0.15em; }
            .hero-subtitle { font-size: 0.75rem; }
            .hero-badge { font-size: 0.55rem; padding: 4px 8px; }
        }

        /* ============================================
           SECTION HEADERS
           ============================================ */
        .section-header {
            display: flex;
            align-items: center;
            gap: 24px;
            margin-bottom: 48px;
        }

        .section-header-line {
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(201, 168, 76, 0.25), transparent);
        }

        .section-title {
            font-family: var(--font-heading);
            font-size: clamp(1.6rem, 3.5vw, 2.8rem);
            font-weight: 600;
            color: var(--gold-400);
            letter-spacing: 0.15em;
            text-transform: uppercase;
            white-space: nowrap;
            text-shadow: 0 0 60px rgba(201, 168, 76, 0.15);
        }

        .section-title-bengali {
            font-family: var(--font-bengali);
            letter-spacing: 0;
            text-transform: none;
        }

        @media (max-width: 480px) {
            .section-header { gap: 12px; margin-bottom: 28px; }
        }

        /* ============================================
           GLASS PANEL
           ============================================ */
        .glass-panel {
            background: var(--gradient-card);
            border: 1px solid rgba(201, 168, 76, 0.08);
            border-radius: var(--radius-lg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            transition: all var(--transition-base);
            position: relative;
        }
        .glass-panel::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            padding: 1px;
            background: linear-gradient(160deg, rgba(201, 168, 76, 0.15), rgba(201, 168, 76, 0.02), rgba(201, 168, 76, 0.08));
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
            opacity: 0;
            transition: opacity var(--transition-base);
        }
        .glass-panel:hover {
            border-color: rgba(201, 168, 76, 0.2);
            box-shadow: var(--shadow-gold-hover);
            transform: translateY(-5px);
        }
        .glass-panel:hover::before {
            opacity: 1;
        }

        @media (max-width: 768px) {
            .glass-panel:hover {
                transform: translateY(-2px);
            }
        }

        @media (max-width: 480px) {
            .glass-panel {
                border-radius: var(--radius-md);
            }
        }

        /* ============================================
           MAIN CONTENT
           ============================================ */
        main {
            padding: 48px 0;
        }

        .section-spacing {
            margin-bottom: 80px;
        }

        @media (max-width: 768px) {
            main { padding: 24px 0; }
            .section-spacing { margin-bottom: 48px; }
        }

        /* ============================================
           MOST WANTED CARDS
           ============================================ */
        .featured-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 24px;
        }

        .featured-card {
            padding: 32px;
            position: relative;
            overflow: hidden;
        }

        .featured-card-glow {
            position: absolute;
            right: -50px;
            top: -50px;
            width: 140px;
            height: 140px;
            background: radial-gradient(circle, rgba(201, 168, 76, 0.08) 0%, transparent 70%);
            border-radius: 50%;
            filter: blur(35px);
            transition: all 0.8s ease;
        }
        .featured-card:hover .featured-card-glow {
            background: radial-gradient(circle, rgba(201, 168, 76, 0.2) 0%, transparent 70%);
            transform: scale(1.3);
        }

        .featured-card-name {
            font-family: var(--font-heading);
            font-size: clamp(1.4rem, 3vw, 2rem);
            font-weight: 600;
            color: #fff;
            margin-bottom: 10px;
            transition: all var(--transition-base);
            letter-spacing: 0.03em;
        }
        .featured-card:hover .featured-card-name {
            color: var(--gold-300);
            letter-spacing: 0.06em;
        }

        .featured-card-desc {
            font-size: 0.85rem;
            color: var(--text-secondary);
            line-height: 1.8;
            margin-bottom: 24px;
            min-height: 50px;
        }

        .price-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

        .price-chip {
            background: linear-gradient(160deg, rgba(201, 168, 76, 0.06) 0%, rgba(0, 0, 0, 0.4) 100%);
            border: 1px solid rgba(201, 168, 76, 0.1);
            border-radius: var(--radius-md);
            padding: 12px 6px;
            text-align: center;
            transition: all var(--transition-base);
            position: relative;
            overflow: hidden;
        }
        .price-chip::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(160deg, rgba(201, 168, 76, 0.12) 0%, transparent 60%);
            opacity: 0;
            transition: opacity var(--transition-base);
        }
        .featured-card:hover .price-chip {
            border-color: rgba(201, 168, 76, 0.3);
        }
        .featured-card:hover .price-chip::after {
            opacity: 1;
        }

        .price-chip-label {
            display: block;
            font-family: var(--font-accent);
            font-size: 0.6rem;
            color: var(--gold-400);
            letter-spacing: 0.15em;
            margin-bottom: 5px;
            text-transform: uppercase;
            position: relative;
            z-index: 1;
        }

        .price-chip-value {
            font-family: var(--font-body);
            font-weight: 700;
            font-size: 0.95rem;
            color: #fff;
            position: relative;
            z-index: 1;
        }

        .price-grid-5 {
            grid-template-columns: repeat(5, 1fr);
        }

        @media (max-width: 900px) {
            .featured-grid { grid-template-columns: 1fr; }
        }

        @media (max-width: 480px) {
            .featured-card { padding: 20px 16px; }
            .featured-card-name { font-size: 1.15rem; }
            .featured-card-desc { font-size: 0.8rem; min-height: auto; margin-bottom: 14px; }
            .price-grid { gap: 6px; }
            .price-chip { padding: 8px 4px; }
            .price-chip-label { font-size: 0.55rem; }
            .price-chip-value { font-size: 0.75rem; }
            .price-grid-5 { grid-template-columns: repeat(3, 1fr); }
        }

        @media (max-width: 360px) {
            .featured-card { padding: 16px 12px; }
            .featured-card-name { font-size: 1rem; }
            .featured-card-desc { font-size: 0.75rem; }
            .price-grid { grid-template-columns: repeat(2, 1fr); gap: 6px; }
            .price-grid-5 { grid-template-columns: repeat(2, 1fr); }
            .price-chip { padding: 8px 6px; }
            .price-chip-label { font-size: 0.5rem; }
            .price-chip-value { font-size: 0.7rem; }
        }

        /* ============================================
           TABLES (New Arrivals, Previous, etc.)
           ============================================ */
        .table-wrapper {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            border-radius: var(--radius-lg);
        }

        .premium-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        .premium-table thead tr {
            background: var(--gradient-gold);
        }
        .premium-table thead th {
            padding: 18px 20px;
            font-family: var(--font-accent);
            font-weight: 600;
            color: #080604;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            white-space: nowrap;
        }
        .premium-table thead th:first-child {
            font-family: var(--font-bengali);
            text-transform: none;
            letter-spacing: 0;
            font-size: 0.95rem;
            font-weight: 700;
        }
        .premium-table thead th:not(:first-child):not(:last-child) {
            text-align: center;
        }
        .premium-table thead th:last-child {
            font-family: var(--font-bengali);
            text-transform: none;
            letter-spacing: 0;
            font-size: 0.95rem;
            font-weight: 700;
            min-width: 220px;
        }

        .premium-table tbody tr {
            border-bottom: 1px solid rgba(201, 168, 76, 0.05);
            transition: all var(--transition-base);
        }
        .premium-table tbody tr:hover {
            background: linear-gradient(90deg, rgba(201, 168, 76, 0.08) 0%, transparent 100%);
            box-shadow: inset 3px 0 0 0 var(--gold-400);
        }
        .premium-table tbody tr:last-child {
            border-bottom: none;
        }

        .premium-table tbody td {
            padding: 16px 20px;
            vertical-align: middle;
        }

        .td-name {
            font-family: var(--font-heading);
            font-weight: 600;
            color: #fff;
            font-size: 1.05rem;
            letter-spacing: 0.02em;
        }
        .td-name-stockout {
            color: var(--red-accent);
        }

        .stockout-badge {
            display: inline-block;
            font-family: var(--font-accent);
            font-size: 0.6rem;
            font-weight: 600;
            text-transform: uppercase;
            background: var(--red-bg);
            color: #FCA5A5;
            padding: 4px 10px;
            border-radius: var(--radius-full);
            margin-left: 10px;
            letter-spacing: 0.1em;
            vertical-align: middle;
            border: 1px solid rgba(229, 91, 91, 0.2);
        }

        .td-price {
            text-align: center;
            font-family: var(--font-accent);
            font-weight: 600;
            color: var(--gold-300);
            font-size: 0.95rem;
            letter-spacing: 0.05em;
        }

        .td-desc {
            font-size: 0.8rem;
            color: var(--text-secondary);
            line-height: 1.6;
        }

        /* Compact table variant (for side-by-side sections) */
        .compact-table thead tr {
            background: rgba(0, 0, 0, 0.6);
            border-bottom: 1px solid rgba(201, 168, 76, 0.15);
        }
        .compact-table thead th {
            color: var(--gold-400);
            font-size: 0.75rem;
            padding: 14px 16px;
            background: transparent;
            font-weight: 500;
        }
        .compact-table thead th:first-child {
            font-size: 0.85rem;
            font-weight: 600;
        }
        .compact-table tbody td {
            padding: 12px 16px;
        }
        .compact-table .td-name {
            font-size: 0.9rem;
        }
        .compact-table .td-price {
            font-size: 0.85rem;
            color: var(--gold-300);
        }

        @media (max-width: 768px) {
            .premium-table thead th { padding: 12px 10px; font-size: 0.75rem; }
            .premium-table tbody td { padding: 10px; }
            .td-name { font-size: 0.8rem; }
            .td-price { font-size: 0.75rem; }
            .td-desc { font-size: 0.7rem; }
            .premium-table thead th:last-child { min-width: 160px; }
        }

        @media (max-width: 480px) {
            .premium-table thead th { padding: 10px 8px; font-size: 0.65rem; }
            .premium-table tbody td { padding: 8px 6px; }
            .td-name { font-size: 0.7rem; }
            .td-price { font-size: 0.65rem; }
            .td-desc { font-size: 0.6rem; line-height: 1.4; }
            .premium-table thead th:last-child { min-width: 120px; }
            .stockout-badge { font-size: 0.45rem; padding: 1px 5px; margin-left: 4px; }
        }

        @media (max-width: 360px) {
            .premium-table thead th { padding: 8px 5px; font-size: 0.6rem; }
            .premium-table tbody td { padding: 6px 4px; }
            .td-name { font-size: 0.65rem; }
            .td-price { font-size: 0.6rem; }
            .td-desc { font-size: 0.55rem; }
            .premium-table thead th:last-child { min-width: 90px; }
        }

        /* ============================================
           TWO-COLUMN LAYOUT
           ============================================ */
        .two-col-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 28px;
        }

        .two-col-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 20px;
        }

        .two-col-title {
            font-family: var(--font-heading);
            font-size: clamp(1.2rem, 2.5vw, 1.8rem);
            font-weight: 600;
            color: var(--gold-400);
            letter-spacing: 0.12em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .two-col-title-bengali {
            font-family: var(--font-bengali);
            letter-spacing: 0;
            text-transform: none;
        }

        .two-col-line {
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, rgba(212, 175, 55, 0.4), transparent);
        }

        @media (max-width: 900px) {
            .two-col-grid { grid-template-columns: 1fr; }
        }

        @media (max-width: 480px) {
            .two-col-grid { gap: 20px; }
            .two-col-header { gap: 10px; margin-bottom: 14px; }
            .two-col-title { font-size: 1rem; }
        }

        /* ============================================
           ROYAL PACKAGES
           ============================================ */
        .packages-grid {
            display: grid;
            grid-template-columns: 1fr;
            max-width: 800px;
            margin: 0 auto;
            gap: 20px;
        }

        .pkg-card {
            padding: 28px;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
        }

        .pkg-card-glow {
            position: absolute;
            right: -40px;
            top: -40px;
            width: 100px;
            height: 100px;
            background: radial-gradient(circle, rgba(201, 168, 76, 0.08) 0%, transparent 70%);
            border-radius: 50%;
            filter: blur(25px);
            transition: all 0.6s ease;
        }
        .pkg-card:hover .pkg-card-glow {
            background: radial-gradient(circle, rgba(201, 168, 76, 0.25) 0%, transparent 70%);
            transform: scale(1.3);
        }

        .pkg-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 18px;
            margin-bottom: 18px;
            border-bottom: 1px solid rgba(201, 168, 76, 0.1);
        }

        .pkg-name {
            font-family: var(--font-heading);
            font-size: 1.4rem;
