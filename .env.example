# ============================================================
# KAHF Treasure — Frontend Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is gitignored.

# Backend API URL (used by server-side fetch in Server Components)
BACKEND_URL=http://localhost:5000

# Public API base URL (used by client-side fetch in browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# WhatsApp number for orders/inquiries (with country code, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=8801681253714

# Cloudinary cloud name (public — used for image URL transforms on the client)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# EmailJS (contact form — client-side, keys are public by design)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Google Analytics 4 (Phase 1 — uncomment when ready)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
